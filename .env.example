# Postgres connection string. Railway injects this automatically when you add
# a Postgres plugin and reference it. Locally, point it at your dev database.
DATABASE_URL=postgres://user:password@localhost:5432/blog

# Better Auth — generate a long random secret (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me
# Public base URL of the site. Used for auth callbacks, OG images and RSS.
BETTER_AUTH_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that projects use to POST their release notes to /api/releases.
RELEASES_INGEST_TOKEN=change-me

# Optional: GitHub OAuth for admin login (Sam only). Leave blank to use
# email + password instead.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
