{
	"compilerOptions": {
		"strict": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node", "vite/client"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "drizzle.config.ts"]
}
